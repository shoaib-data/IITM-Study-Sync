rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['syedshoaib.outlook@gmail.com', 'shoaibsyedx@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isFriend(targetUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        targetUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends;
    }

    function isValidStickyNote(data) {
      return data.keys().hasAll(['title', 'content', 'isGeneral', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'content', 'isGeneral', 'courseId', 'termId', 'color', 'updatedAt']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.content is string && data.content.size() <= 5000 &&
        data.isGeneral is bool &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
        (!('termId' in data) || (data.termId is string && data.termId.size() <= 64)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 32));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: only admin can list all users; authenticated users can read their own or friends' profiles
    match /users/{uid} {
      allow get: if isUser(uid) || isFriend(uid) || isAdmin();
      allow list: if isAdmin();
      // Allow user creation by owner
      allow create: if isUser(uid);
      // Allow user update by owner, or allowing friend requests to update friends array
      allow update: if isUser(uid) || 
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])) ||
        isAdmin();
      allow delete: if false;

      // Subcollection: terms
      match /terms/{termId} {
        allow read: if isUser(uid) || isFriend(uid) || isAdmin();
        allow write: if isUser(uid) || isAdmin();

        // Subcollection: courses
        match /courses/{courseId} {
          allow read: if isUser(uid) || isFriend(uid) || isAdmin();
          allow write: if isUser(uid) || isAdmin();
        }
      }

      // Subcollection: tasks (Planner) - only the signed-in owner can read, create, update, or delete. Friends and admin cannot read them.
      match /tasks/{taskId} {
        allow read, write: if isUser(uid);
      }

      // Subcollection: studyLogs (Daily Study Log) - only the signed-in owner can read, create, update, or delete.
      match /studyLogs/{logId} {
        allow read, write: if isUser(uid);
      }

      // Subcollection: stickyNotes (Planner Sticky Notes) - only the signed-in owner can read or write; 'general' cannot be deleted.
      match /stickyNotes/{noteId} {
        allow read: if isUser(uid);
        allow create, update: if isUser(uid) &&
          noteId is string &&
          noteId.size() > 0 &&
          noteId.size() <= 128 &&
          isValidStickyNote(request.resource.data);
        allow delete: if isUser(uid) && noteId != 'general';
      }
    }

    // Friend code lookup document: allows direct friend search without listing the entire users collection
    match /friendCodes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Course Catalog collection (admin-managed, publicly readable, seedable if empty)
    match /courseCatalog/{courseId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSignedIn() || request.resource.data.source == 'manually seeded';
      allow delete: if isAdmin();
    }

    // Academic Calendar collection (admin-managed / server-managed, read-only for users)
    match /calendar/{termId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSignedIn() || request.resource.data.source == 'manually seeded';
      allow delete: if isAdmin() || isSignedIn() || (resource != null && (resource.data.source == 'manually seeded' || termId == 'May2026'));
    }

    // Friend Requests collection
    match /friendRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
    }

    // Site Traffic analytics: only admin can read traffic stats
    match /siteTraffic/{docId} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Traffic logs: only admin can read; users can only write their own visit record and cannot read anyone else's
    match /trafficLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() ? (request.resource.data.userId == request.auth.uid) : (request.resource.data.userId == null);
      allow update, delete: if isAdmin();
    }

    // Daily active users: only admin can read; students can only write their own login record and cannot read anyone else's
    match /dailyActiveUsers/{docId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Resources collection: all signed-in users can read; only the admin can create, update, or delete
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

